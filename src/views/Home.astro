---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Yarn from "../components/Yarn.astro";
import AppCta from "../components/AppCta.astro";
import { getCopy, localePath, abs, APP_STORE_URL, SITE_URL, PODCAST_ENABLED } from "../lib/site";

import city1 from "../assets/art/city1.jpg";
import map from "../assets/art/map.jpg";
import ladies from "../assets/art/ladies.jpg";
import officeA from "../assets/art/officeA.jpg";
import hushNote from "../assets/art/hush-note.jpg";
import courthouse from "../assets/art/courthouse.jpg";
import officeB from "../assets/art/officeB.jpg";
import kip from "../assets/art/kip.png";
import nora from "../assets/art/nora.png";
import peeps from "../assets/art/peeps.png";
import granny from "../assets/art/granny.png";

const { lang = "en" } = Astro.props;
const c = getCopy(lang);
const h = c.home;
const stepImgs = [ladies, officeA, hushNote, courthouse];
const castImgs = [kip, nora, peeps, granny];

const game: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": ["VideoGame", "MobileApplication"],
  name: "Bad Leads",
  description: h.description,
  url: abs(localePath(lang, "/")),
  image: abs("/og/home.jpg"),
  genre: ["Mystery", "Comedy"],
  applicationCategory: "GameApplication",
  operatingSystem: "iOS",
  gamePlatform: "iOS",
  playMode: "SinglePlayer",
  inLanguage: lang,
  contentRating: "13+",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
if (APP_STORE_URL) { game.downloadUrl = APP_STORE_URL; game.installUrl = APP_STORE_URL; }

const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: h.faq.items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
const site = { "@context": "https://schema.org", "@type": "WebSite", name: "Bad Leads", url: SITE_URL + "/", inLanguage: lang };
---
<Base lang={lang} title={h.title} description={h.description} path="/" ogImage="/og/home.jpg" ogAlt={h.ogAlt} overlay jsonld={[game, faq, site]}>
  <section class="hero">
    <Picture class="hero__img" pictureAttributes={{ class: "hero__pic" }} src={city1} formats={["avif", "webp"]} fallbackFormat="webp" widths={[640, 960, 1280]} sizes="100vw" alt={h.hero.imageAlt} loading="eager" fetchpriority="high" />
    <div class="wrap hero__copy">
      <p class="eyebrow">A comedy murder mystery</p>
      <h1 class="neon"><span>Bad</span> <span>Leads</span></h1>
      <p class="hero__sub">{h.hero.sub}</p>
      <div class="actions"><AppCta lang={lang} />{PODCAST_ENABLED && <a class="text-link" href={localePath(lang, "/podcast/")}>{c.cta.listen} <span aria-hidden="true">↗</span></a>}</div>
    </div>
    <div class="hero__bottom">The Old Quarter <span>Case no. 001</span></div>
  </section>
  <section class="opening section"><div class="wrap opening__inner">
    <div><p class="eyebrow">A message from the detective</p><h2 class="h2">Play the opening</h2><button class="play-opening" type="button" aria-label="Play opening narration" aria-pressed="false"><span aria-hidden="true">▶</span></button><audio id="opening-audio" preload="none" src="/audio/opening.mp3"></audio><p class="opening__hint">Kip Hartley · opening narration</p></div>
    <figure><blockquote id="opening-subtitle" data-line={h.quote.text}>{h.quote.text}</blockquote><figcaption>{h.quote.by}</figcaption></figure>
  </div></section>
  <section class="section how" id="how"><div class="wrap"><div class="how__head"><p class="eyebrow">The investigation</p><h2 class="h2">{h.how.h2}</h2><p class="lead">{h.how.lead}</p></div>
    <div class="board"><svg class="board__yarn" viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true"><path d="M120 90 C260 20 290 260 390 150 S600 45 640 170 S800 240 900 100" /></svg>
      {h.how.steps.map((s, i) => <article class="polaroid"><span class="pin" aria-hidden="true"></span><Picture src={stepImgs[i]} formats={["avif", "webp"]} fallbackFormat="webp" widths={[320, 480, 640]} sizes="(min-width: 900px) 260px, 80vw" alt={s.alt} loading="lazy" /><div class="polaroid__caption"><span>0{i + 1}</span><h3>{s.title}</h3><p>{s.text}</p></div></article>)}
    </div></div></section>
  <section class="section cast" id="cast"><div class="wrap"><p class="eyebrow">Persons of interest</p><h2 class="h2">{h.cast.h2}</h2><div class="cast-grid">
    {h.cast.people.map((p, i) => <article class="person"><div class="person__fig"><Picture src={castImgs[i]} formats={["avif", "webp"]} fallbackFormat="webp" widths={[240, 360, 480]} sizes="(min-width: 900px) 260px, 45vw" alt={p.alt} loading="lazy" /></div><div class="person__txt"><p class="person__role">{p.role}</p><h3>{p.name}</h3><p>{p.text}</p></div></article>)}
  </div></div></section>
  {PODCAST_ENABLED && <section class="section podcast-paper" id="podcast"><div class="wrap"><div class="newspaper"><p class="newspaper__masthead">The Old Quarter Courier</p><div class="newspaper__rule">CITY DESK <span>AFTER HOURS</span></div><div class="newspaper__content"><div><p class="eyebrow">On the air</p><h2>{h.podcast.h2}</h2><p>{h.podcast.text}</p><a class="ink-link" href={localePath(lang, "/podcast/")}>{c.cta.listen} →</a></div><Picture src={officeB} formats={["avif", "webp"]} fallbackFormat="webp" widths={[480, 720, 960]} sizes="(min-width: 800px) 40vw, 90vw" alt={h.podcast.imageAlt} loading="lazy" /></div></div></div></section>}
  <section class="section faq-section" id="faq"><div class="wrap faq"><div><p class="eyebrow">From the files</p><h2 class="h2">{h.faq.h2}</h2></div><div class="faq__list">{h.faq.items.map((item, i) => <article class="faq-card"><button type="button" aria-expanded="false" aria-controls={`answer-${i}`}><span>{item.q}</span><span aria-hidden="true">+</span></button><p id={`answer-${i}`} hidden>{item.a}</p></article>)}</div></div></section>
  <section class="closing"><Picture pictureAttributes={{ class: "closing__pic" }} src={city1} formats={["avif", "webp"]} fallbackFormat="webp" widths={[640, 960, 1280]} sizes="100vw" alt={h.hero.imageAlt} loading="lazy" /><div class="wrap closing__copy"><p class="eyebrow">The case is waiting</p><h2 class="neon"><span>Bad</span> <span>Leads</span></h2><p>{h.closing.text}</p><div class="actions"><AppCta lang={lang} /></div></div></section>
</Base>
<script>
  const audio = document.querySelector<HTMLAudioElement>('#opening-audio');
  const play = document.querySelector<HTMLButtonElement>('.play-opening');
  const subtitle = document.querySelector<HTMLElement>('#opening-subtitle');
  if (audio && play && subtitle) {
    const line = subtitle.dataset.line || '';
    play.addEventListener('click', () => { if (audio.paused) { audio.play().catch(() => {}); } else audio.pause(); });
    audio.addEventListener('play', () => { play.setAttribute('aria-pressed', 'true'); play.setAttribute('aria-label', 'Pause opening narration'); play.firstElementChild!.textContent = 'Ⅱ'; });
    audio.addEventListener('pause', () => { play.setAttribute('aria-pressed', 'false'); play.setAttribute('aria-label', 'Play opening narration'); play.firstElementChild!.textContent = '▶'; });
    audio.addEventListener('timeupdate', () => { if (Number.isFinite(audio.duration)) subtitle.textContent = line.slice(0, Math.ceil(line.length * Math.min(1, audio.currentTime / audio.duration))); });
    audio.addEventListener('ended', () => { subtitle.textContent = line; });
  }
  document.querySelectorAll<HTMLButtonElement>('.faq-card button').forEach(button => button.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!open)); const answer = document.getElementById(button.getAttribute('aria-controls')!); if (answer) answer.hidden = open; }));
  const board = document.querySelector('.board');
  if (board && 'IntersectionObserver' in window) { const observer = new IntersectionObserver(entries => { if (entries[0].isIntersecting) { board.classList.add('is-visible'); observer.disconnect(); } }, { threshold: .15 }); observer.observe(board); }
</script>
