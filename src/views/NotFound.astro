---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import { getCopy, localePath } from "../lib/site";
import officeB from "../assets/art/officeB.jpg";
const { lang = "en" } = Astro.props;
const c = getCopy(lang);
---
<Base lang={lang} title={c.notFound.title} description={c.notFound.text} path="/404.html" noindex>
  <div class="wrap lost">
    <div class="lost__room scan" aria-hidden="true">
      <Picture src={officeB} formats={["avif", "webp"]} fallbackFormat="webp" widths={[640, 960]} sizes="(min-width: 48rem) 704px, 100vw" alt="" loading="eager" />
    </div>
    <p class="readout on">PEEPS SCAN · nothing here, friend</p>
    <h1>{c.notFound.h1}</h1>
    <p class="lead">{c.notFound.text}</p>
    <a class="btn btn--primary" href={localePath(lang, "/")}>{c.notFound.home}</a>
  </div>
</Base>
