---
import "../styles/global.css";
import { getCopy, localePath, abs, alternates, SITE_URL, CONTACT_EMAIL, PODCAST_ENABLED } from "../lib/site";

interface Props {
  lang?: string;
  title: string;
  description: string;
  path: string; // canonical path for the default language, e.g. "/podcast/"
  ogImage?: string;
  ogAlt?: string;
  overlay?: boolean;
  current?: "podcast" | "";
  noindex?: boolean;
  jsonld?: object[];
  feed?: boolean;
}
const { lang = "en", title, description, path, ogImage = "/og/page.jpg", ogAlt = "Bad Leads", overlay = false, current = "", noindex = false, jsonld = [], feed = false } = Astro.props;
const c = getCopy(lang);
const home = localePath(lang, "/");
const canonical = abs(localePath(lang, path));
const alts = alternates(path);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07090f" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {PODCAST_ENABLED && feed && <link rel="alternate" type="application/rss+xml" title="Bad Leads podcast" href="/podcast/feed.xml" />}
    <link rel="expect" href="#main" blocking="render" />
    <link rel="preload" href="/fonts/bebas-neue-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bad Leads" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : lang} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(ogImage)} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={["site-header", overlay ? "site-header--overlay" : "site-header--bar"]}>
      <div class="wrap site-header__in">
        <a class="wordmark" href={home}>Bad Leads</a>
        <nav class="nav" aria-label={c.nav.menuLabel}>
          <a href={`${home}#theory`}>{c.nav.theory}</a>
          <a href={`${home}#search`}>{c.nav.search}</a>
          <a href={`${home}#talk`}>{c.nav.talk}</a>
          <a href={`${home}#office`}>{c.nav.office}</a>
          <a href={`${home}#court`}>{c.nav.court}</a>
          {PODCAST_ENABLED && <a href={localePath(lang, "/podcast/")} aria-current={current === "podcast" ? "page" : undefined}>{c.nav.podcast}</a>}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap site-footer__in">
        <a class="wordmark" href={home}>Bad Leads</a>
        <nav aria-label="Footer">
          {PODCAST_ENABLED && <a href={localePath(lang, "/podcast/")}>{c.footer.podcast}</a>}
          <a href={localePath(lang, "/privacy/")}>{c.footer.privacy}</a>
          <a href={localePath(lang, "/support/")}>{c.footer.support}</a>
          <a href={`mailto:${CONTACT_EMAIL}`}>{c.footer.contact}</a>
        </nav>
        <small>{c.footer.rights}</small>
        <small>{c.footer.appleCredit}</small>
      </div>
    </footer>
  </body>
</html>
